{
  "name": "Revoke_Reason_FM",
  "expression": [
    "",
    " ",
    "VAR CurrentRequest =",
    " ",
    "    SELECTEDVALUE(",
    " ",
    "        'EDWH_PLAT_APPLICANT_REQUESTS_FACT'[APPLICANT_REQ_KEY]",
    " ",
    "    )",
    " ",
    "VAR ReasonKey =",
    " ",
    "    CALCULATE(",
    " ",
    "        SELECTEDVALUE(",
    " ",
    "            'EDWH_PLAT_APP_REQST_REVOKE_DIM'[REVOKE_REASON_KEY]",
    " ",
    "        ),",
    " ",
    "        TREATAS(",
    " ",
    "            { CurrentRequest },",
    " ",
    "            'EDWH_PLAT_APP_REQST_REVOKE_DIM'[APPLICANT_REQ_KEY]",
    " ",
    "        )",
    " ",
    "    )",
    " ",
    "RETURN",
    " ",
    "CALCULATE(",
    " ",
    "    SELECTEDVALUE(",
    " ",
    "        'EDWH_PLAT_REQ_REVOKE_REASONS_DIM'[REVOKE_REASON_NAME_AR]",
    " ",
    "    ),",
    " ",
    "    TREATAS(",
    " ",
    "        { ReasonKey },",
    " ",
    "        'EDWH_PLAT_REQ_REVOKE_REASONS_DIM'[REVOKE_REASON_KEY]",
    " ",
    "    )",
    " ",
    ")"
  ]
}