    "    LOOKUPVALUE ( EDWH_PLAT_APPLICATION_STG_ASGN_DIM[Stage Group AR],EDWH_PLAT_APPLICATION_STG_ASGN_DIM[STAGE_ASSIGNEE_KEY], MaxKey )"
  ]
}