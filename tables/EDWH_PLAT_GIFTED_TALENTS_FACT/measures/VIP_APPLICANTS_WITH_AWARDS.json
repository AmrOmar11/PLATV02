{
  "name": "VIP_APPLICANTS_WITH_AWARDS",
  "expression": [
    "",
    "VAR ValidApplicants =",
    "    CALCULATETABLE(",
    "        VALUES(",
    "            'EDWH_PLAT_NIC_MONTHLY_UPDATE_DIM'[APPLICANT_KEY]",
    "        ),",
    "        'EDWH_PLAT_NIC_MONTHLY_UPDATE_DIM'[DESCRIPTION] = \"صالح\"",
    "    )",
    "",
    "VAR AwardedApplications =",
    "    CALCULATETABLE(",
    "        VALUES(",
    "            'EDWH_PLAT_GIFTED_TALENTS_FACT'[APPLICATION_KEY]",
    "        ),",
    "        'EDWH_PLAT_GIFTED_TALENTS_FACT'[AWARD_KEY] <> BLANK(),",
    "        'EDWH_PLAT_GIFTED_TALENTS_FACT'[AWARD_KEY] <> -1",
    "    )",
    "",
    "VAR ApplicantsWithAwards =",
    "    CALCULATETABLE(",
    "        VALUES(",
    "            'EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICANT_KEY]",
    "        ),",
    "        TREATAS(",
    "            AwardedApplications,",
    "            'EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICATION_KEY]",
    "        )",
    "    )",
    "",
    "RETURN",
    "    COUNTROWS(",
    "        INTERSECT(",
    "            ValidApplicants,",
    "            ApplicantsWithAwards",
    "        )",
    "    )"
  ]
}