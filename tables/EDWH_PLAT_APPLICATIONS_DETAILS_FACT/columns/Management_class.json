{
  "type": "calculated",
  "name": "Management_class",
  "dataType": "string",
  "isDataTypeInferred": true,
  "expression": [
    "",
    "VAR StatusKey =",
    "    EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_STATUS_KEY]",
    "RETURN",
    "    SWITCH(",
    "        TRUE(),",
    "",
    "        // الطلبات لدى الادارة",
    "        StatusKey IN {",
    "            18,  // تم التقديم",
    "            19,  // مرفوض",
    "            20,  // تم تخطي نظام النقاط",
    "            27   // مغلق",
    "        },",
    "        \"الطلبات لدى الادارة\",",
    "",
    "        // مقبول بإنتظار الاصدار",
    "        StatusKey IN {",
    "            22,  // بانتظار مراجعة الدفع",
    "            24   // بإنتظار إصدار إقامة المقيم المميز",
    "        },",
    "        \"مقبول بإنتظار الاصدار\",",
    "",
    "        // طلبات بانتظار اجراء من المتقدم",
    "        StatusKey IN {",
    "            21,  // بإنتظار دفع رسوم الإقامة المميزة",
    "            23   // الطلب متاح للتعديل",
    "        },",
    "        \"طلبات بانتظار اجراء من المتقدم\",",
    "",
    "        // كل الحالات الأخرى",
    "        \"أخرى\"",
    "    )"
  ]
}