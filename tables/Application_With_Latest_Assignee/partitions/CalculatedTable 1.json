{
  "name": "CalculatedTable 1",
  "source": {
    "type": "calculated",
    "expression": [
      "",
      "ADDCOLUMNS(",
      "    SUMMARIZE(",
      "        'EDWH_PLAT_APPLICATIONS_DIM',",
      "        'EDWH_PLAT_APPLICATIONS_DIM'[APPLICATION_KEY]",
      "    ),",
      "",
      "    \"LATEST_CREATED_AT\",",
      "        VAR CurrentApplication =",
      "            [APPLICATION_KEY]",
      "        RETURN",
      "            MAXX(",
      "                TOPN(",
      "                    1,",
      "                    FILTER(",
      "                        ALL('EDWH_PLAT_APPLICATION_STG_ASGN_FACT'),",
      "                        'EDWH_PLAT_APPLICATION_STG_ASGN_FACT'[APPLICATION_KEY]",
      "                            = CurrentApplication",
      "                    ),",
      "                    'EDWH_PLAT_APPLICATION_STG_ASGN_FACT'[CREATED_AT], DESC",
      "                ),",
      "                'EDWH_PLAT_APPLICATION_STG_ASGN_FACT'[CREATED_AT]",
      "            ),",
      "",
      "    \"STAGE_ASSIGNEE_KEY\",",
      "        VAR CurrentApplication =",
      "            [APPLICATION_KEY]",
      "        VAR LatestRow =",
      "            TOPN(",
      "                1,",
      "                FILTER(",
      "                    ALL('EDWH_PLAT_APPLICATION_STG_ASGN_FACT'),",
      "                    'EDWH_PLAT_APPLICATION_STG_ASGN_FACT'[APPLICATION_KEY]",
      "                        = CurrentApplication",
      "                ),",
      "                'EDWH_PLAT_APPLICATION_STG_ASGN_FACT'[CREATED_AT], DESC",
      "            )",
      "        RETURN",
      "            MAXX(",
      "                LatestRow,",
      "                'EDWH_PLAT_APPLICATION_STG_ASGN_FACT'[STAGE_ASSIGNEE_KEY]",
      "            )",
      ")"
    ]
  }
}