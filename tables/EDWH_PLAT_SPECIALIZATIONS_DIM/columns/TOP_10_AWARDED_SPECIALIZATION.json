{
  "type": "calculated",
  "name": "TOP_10_AWARDED_SPECIALIZATION",
  "dataType": "string",
  "isDataTypeInferred": true,
  "expression": [
    "VAR CurrentSpecializationKey =",
    "    'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_KEY]",
    "",
    "VAR SpecializationAwards =",
    "    ADDCOLUMNS(",
    "        SUMMARIZE(",
    "            ALL('EDWH_PLAT_SPECIALIZATIONS_DIM'),",
    "            'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_KEY],",
    "            'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_NAME_AR]",
    "        ),",
    "        \"@AppsWithAwards\",",
    "            VAR SpecializationKey =",
    "                'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_KEY]",
    "            RETURN",
    "                CALCULATE(",
    "                    [APPS_WITH_AWARDS],",
    "                    REMOVEFILTERS('EDWH_PLAT_SPECIALIZATIONS_DIM'),",
    "                    TREATAS(",
    "                        { SpecializationKey },",
    "                        'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_KEY]",
    "                    )",
    "                )",
    "    )",
    "",
    "VAR Top10Specializations =",
    "    TOPN(",
    "        10,",
    "        SpecializationAwards,",
    "        [@AppsWithAwards], DESC,",
    "        'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_KEY], ASC",
    "    )",
    "",
    "RETURN",
    "    IF(",
    "        CONTAINS(",
    "            Top10Specializations,",
    "            'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_KEY],",
    "            CurrentSpecializationKey",
    "        ),",
    "        'EDWH_PLAT_SPECIALIZATIONS_DIM'[SPECIALIZATION_NAME_AR],",
    "        \"Other\"",
    "    )"
  ]
}