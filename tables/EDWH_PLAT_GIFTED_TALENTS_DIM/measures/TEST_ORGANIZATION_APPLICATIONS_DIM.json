{
  "name": "TEST_ORGANIZATION_APPLICATIONS_DIM",
  "expression": [
    "",
    "VAR SelectedWorkExpKeys =",
    "    VALUES(",
    "        'EDWH_PLAT_WORK_EXPERIENCES_DIM'[WORK_EXP_KEY]",
    "    )",
    "",
    "VAR OrganizationApplicationKeys =",
    "    CALCULATETABLE(",
    "        VALUES(",
    "            'EDWH_PLAT_WORK_EXPERIENCES_FACT'[APPLICATION_KEY]",
    "        ),",
    "        TREATAS(",
    "            SelectedWorkExpKeys,",
    "            'EDWH_PLAT_WORK_EXPERIENCES_FACT'[WORK_EXP_KEY]",
    "        )",
    "    )",
    "",
    "RETURN",
    "    CALCULATE(",
    "        DISTINCTCOUNT(",
    "            'EDWH_PLAT_APPLICATIONS_DIM'[APPLICATION_KEY]",
    "        ),",
    "        REMOVEFILTERS(",
    "            'EDWH_PLAT_APPLICATIONS_DIM'",
    "        ),",
    "        TREATAS(",
    "            OrganizationApplicationKeys,",
    "            'EDWH_PLAT_APPLICATIONS_DIM'[APPLICATION_KEY]",
    "        )",
    "    )"
  ]
}