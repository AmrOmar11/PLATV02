{
  "name": "REQST_MAX_CREATED_DATE",
  "expression": [
    "",
    "VAR LastCreatedDate =",
    "    CALCULATE(",
    "        MAX('COMMON_DATE_DIM'[DATE]),",
    "        USERELATIONSHIP(",
    "            'EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT],",
    "            'COMMON_DATE_DIM'[COMMON_DATE_DIM_KEY]",
    "        )",
    "    )",
    "RETURN",
    "    MIN(LastCreatedDate, TODAY())"
  ]
}