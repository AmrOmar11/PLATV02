{
  "type": "calculated",
  "name": "SLA_per_management",
  "dataType": "string",
  "isDataTypeInferred": true,
  "expression": [
    "",
    "VAR StageKey =",
    "    EDWH_PLAT_APPLICATIONS_DETAILS_FACT[STAGE_ID]",
    "VAR NumberOfDays =",
    "    EDWH_PLAT_APPLICATIONS_DETAILS_FACT[numDaysExcludingWeekends]",
    "VAR ValidStatus =",
    "    StageKey IN {",
    "        80,              // تم التدقيق",
    "        99, 100,         // في مرحلة الإصدار",
    "        101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112,",
    "        113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 123,",
    "        124,              // في مرحلة الجودة",
    "        125,              // مراجعة الطلبات المرفوضة للتدقيق",
    "        126,              // معالجة التوصيات النهائية",
    "        133,              // مرفوض تدقيق",
    "        134,              // مرفوض تحليل مبدئي",
    "        135               // مرفوض مسح أو تحقق",
    "    }",
    "RETURN",
    "    SWITCH(",
    "        TRUE(),",
    "        NOT ValidStatus, \"0\",",
    "        ISBLANK(NumberOfDays), \"0\",",
    "        NumberOfDays <= 30, \"30-0 يوم\",",
    "        NumberOfDays <= 60, \"60-31 يوم\",",
    "        NumberOfDays <= 90, \"90-61 يوم\",",
    "        NumberOfDays > 90, \"+90 يوم\",",
    "        \"0\"",
    "    )"
  ]
}