{
  "name": "New Calculated Table",
  "mode": "import",
  "source": {
    "type": "calculated",
    "expression": [
      "",
      "ADDCOLUMNS(",
      "",
      "    SUMMARIZE(",
      "",
      "         'EDWH_PLAT_APPLICANT_REQUESTS_FACT'",
      ",",
      "",
      "         'EDWH_PLAT_APPLICANT_REQUESTS_FACT'[APPLICANT_REQ_KEY]",
      "",
      "",
      "    ),",
      " ",
      "    \"LATEST_CREATED_AT\",",
      "",
      "        VAR CurrentRequestApplicant =",
      "",
      "            [APPLICANT_REQ_KEY]",
      "",
      "        RETURN",
      "",
      "            MAXX(",
      "",
      "                TOPN(",
      "",
      "                    1,",
      "",
      "                    FILTER(",
      "",
      "                        ALL('EDWH_PLAT_APP_REQST_ASGN_FACT'),",
      "",
      "                        'EDWH_PLAT_APP_REQST_ASGN_FACT'[APPLICANT_REQ_KEY]",
      "",
      "                            = CurrentRequestApplicant",
      "",
      "                    ),",
      "",
      "                    'EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT], DESC",
      "",
      "                ),",
      "",
      "                'EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT]",
      "",
      "            ),",
      " ",
      "    \"STAGE_ASSIGNEE_KEY\",",
      "",
      "        VAR CurrentRequestApplicant =",
      "",
      "            [APPLICANT_REQ_KEY]",
      "",
      "        VAR LatestRow =",
      "",
      "            TOPN(",
      "",
      "                1,",
      "",
      "                FILTER(",
      "",
      "                    ALL('EDWH_PLAT_APP_REQST_ASGN_FACT'),",
      "",
      "                     'EDWH_PLAT_APP_REQST_ASGN_FACT'[APPLICANT_REQ_KEY]",
      "",
      "                        = CurrentRequestApplicant",
      "",
      "                ),",
      "",
      "                'EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT], DESC",
      "",
      "            )",
      "",
      "        RETURN",
      "",
      "            MAXX(",
      "",
      "                LatestRow,",
      "",
      "                'EDWH_PLAT_APP_REQST_ASGN_FACT'[STAGE_ASSIGNEE_KEY]",
      "",
      "            )",
      "",
      ")",
      " "
    ]
  }
}