      {
        "name": "EDWH_PLAT_APPLICATIONS_DETAILS_FACT",
        "columns": [
          {
            "name": "APPLICANT_KEY",
            "dataType": "int64",
            "sourceColumn": "APPLICANT_KEY",
            "sourceProviderType": "Integer"
          },
          {
            "name": "APPLICATION_KEY",
            "dataType": "int64",
            "sourceColumn": "APPLICATION_KEY",
            "sourceProviderType": "Integer"
          },
          {
            "name": "SPONSOR_ENTITY_KEY",
            "dataType": "int64",
            "sourceColumn": "SPONSOR_ENTITY_KEY",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "APPLICATION_STATUS_KEY",
            "dataType": "int64",
            "sourceColumn": "APPLICATION_STATUS_KEY",
            "sourceProviderType": "Integer"
          },
          {
            "name": "APPLICATION_PLACE_KEY",
            "dataType": "int64",
            "sourceColumn": "APPLICATION_PLACE_KEY",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "APPLICATION_PAYMENT_STATUS",
            "dataType": "int64",
            "sourceColumn": "APPLICATION_PAYMENT_STATUS",
            "sourceProviderType": "Integer"
          },
          {
            "name": "APP_SUBMISSION_DATE_KEY",
            "dataType": "int64",
            "sourceColumn": "APP_SUBMISSION_DATE_KEY",
            "sourceProviderType": "Integer"
          },
          {
            "name": "APP_LATEST_UPDATE_DATE_KEY",
            "dataType": "int64",
            "sourceColumn": "APP_LATEST_UPDATE_DATE_KEY",
            "sourceProviderType": "Integer"
          },
          {
            "name": "APP_COMPLETION_DATE_KEY",
            "dataType": "int64",
            "sourceColumn": "APP_COMPLETION_DATE_KEY",
            "sourceProviderType": "Integer"
          },
          {
            "name": "NO_OF_DEPENDENTS",
            "dataType": "int64",
            "sourceColumn": "NO_OF_DEPENDENTS",
            "sourceProviderType": "Integer"
          },
          {
            "type": "calculated",
            "name": "Calculated Column 1",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "expression": "IF(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APP_COMPLETION_DATE_KEY] = EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APP_LATEST_UPDATE_DATE_KEY] , TRUE() , FALSE())",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\""
          },
          {
            "type": "calculated",
            "name": "numDaysExcludingWeekends",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "RELATED(",
              "    COMMON_END_DATE_DIM[numDaysExcludingWeekends]",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "SLA_per_management",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR StatusKey =",
              "    EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_STATUS_KEY]",
              "VAR NumberOfDays =",
              "    EDWH_PLAT_APPLICATIONS_DETAILS_FACT[numDaysExcludingWeekends]",
              "VAR ValidStatus =",
              "    StatusKey IN {",
              "        18,  // Submitted - تم التقديم",
              "        19,  // Rejected - مرفوض",
              "        20,  // Passed point system",
              "        23,  // Update the application",
              "        26,  // Completed - مكتمل",
              "        27   // Closed - مغلق",
              "    }",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        NOT ValidStatus, \"0\",",
              "        ISBLANK(NumberOfDays), \"0\",",
              "        NumberOfDays <= 30, \"30-0 يوم\",",
              "        NumberOfDays <= 60, \"60-31 يوم\",",
              "        NumberOfDays <= 90, \"90-61 يوم\",",
              "        NumberOfDays > 90, \"+90 يوم\",",
              "        \"0\"",
              "    )"
            ]
          }
        ],
        "partitions": [
          {
            "name": "EDWH_PLAT_APPLICATIONS_DETAILS_FACT",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [EDWH].[EDWH_PLAT_APPLICATIONS_DETAILS_FACT].*   FROM [EDWH].[EDWH_PLAT_APPLICATIONS_DETAILS_FACT] ",
              "dataSource": "SqlServer DESKTOP-61EFDIR EDWH"
            }
          }
        ],
        "measures": [
          {
            "name": "_Completed_App",
            "expression": "CALCULATE(DISTINCTCOUNT(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_KEY]),EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_STATUS_KEY] in {25,26,28},DATESBETWEEN(COMMON_DATE_DIM[DATE],DATE(YEAR(TODAY()),1,1),TODAY()))"
          },
          {
            "name": "TOTAL_NO_OF_DEPENDENTS",
            "expression": [
              "",
              "SUMX(",
              "    VALUES('EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICANT_KEY]),",
              "    CALCULATE(",
              "        MAX('EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[NO_OF_DEPENDENTS])",
              "    )",
              ")"
            ]
          },
          {
            "name": "APPLICATIONS_COUNT",
            "expression": "DISTINCTCOUNT(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_KEY])"
          },
          {
            "name": "% Applications",
            "expression": [
              "",
              "DIVIDE(",
              "    DISTINCTCOUNT('EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICATION_KEY]),",
              "    CALCULATE(",
              "        DISTINCTCOUNT('EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICATION_KEY]),",
              "        ALLSELECTED('EDWH_PLAT_APPLICATIONS_DETAILS_FACT')",
              "    ),0)"
            ]
          },
          {
            "name": "_COMPLETED_LAST_YEAR",
            "expression": " CALCULATE(DISTINCTCOUNT(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_KEY]),EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_STATUS_KEY] in {25,26,28},SAMEPERIODLASTYEAR(DATESBETWEEN(COMMON_DATE_DIM[DATE],DATE(YEAR(TODAY()),1,1),TODAY())))"
          },
          {
            "name": "All_apps_this_year",
            "expression": "CALCULATE(DISTINCTCOUNT(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_KEY]),EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_STATUS_KEY],DATESBETWEEN(COMMON_DATE_DIM[DATE],DATE(YEAR(TODAY()),1,1),TODAY()))"
          },
          {
            "name": "All_apps_last_year",
            "expression": [
              "",
              "CALCULATE(DISTINCTCOUNT(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_KEY]),EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICATION_STATUS_KEY],SAMEPERIODLASTYEAR(DATESBETWEEN(COMMON_DATE_DIM[DATE],DATE(YEAR(TODAY()),1,1),TODAY())))"
            ]
          },
          {
            "name": "_Taregt_apps",
            "expression": [
              "600",
              ""
            ]
          },
          {
            "name": "New Measure",
            "expression": [
              "\"TEST\"",
              ""
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [EDWH].[EDWH_PLAT_APPLICATIONS_DETAILS_FACT].*   FROM [EDWH].[EDWH_PLAT_APPLICATIONS_DETAILS_FACT] "
