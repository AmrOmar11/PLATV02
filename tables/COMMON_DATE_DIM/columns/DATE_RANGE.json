{
  "type": "calculated",
  "name": "DATE_RANGE",
  "dataType": "string",
  "expression": [
    "",
    "VAR CurrentDate = COMMON_DATE_DIM[DATE]",
    "VAR TodayDate = TODAY()",
    "RETURN",
    "SWITCH(TRUE(),",
    "",
    "        CurrentDate = TodayDate, ",
    "",
    "            \"Daily Report\",",
    "",
    "        YEAR(CurrentDate) = YEAR(TodayDate) && MONTH(CurrentDate) = MONTH(TodayDate), ",
    "",
    "            \"Monthly Report\",",
    "",
    "        YEAR(CurrentDate) = YEAR(TodayDate), ",
    "",
    "            \"Yearly Report\",",
    "",
    "        blank())"
  ]
}