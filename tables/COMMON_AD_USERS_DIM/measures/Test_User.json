{
  "name": "Test_User",
  "expression": [
    " ",
    "VAR U = USERNAME()",
    "VAR NoDomain = SUBSTITUTE(U, \"PR\\\", \"\")",
    "VAR CleanName = SUBSTITUTE(NoDomain, \".\", \" \")",
    "VAR FirstSpace = FIND(\" \", CleanName, 1, LEN(CleanName))",
    "VAR FirstName =",
    "   UPPER(LEFT(CleanName, 1)) &",
    "   LOWER(MID(CleanName, 2, FirstSpace - 2))",
    "VAR LastName =",
    "   UPPER(MID(CleanName, FirstSpace + 1, 1)) &",
    "   LOWER(MID(CleanName, FirstSpace + 2, LEN(CleanName)))",
    "RETURN",
    "   FirstName & \" \" & LastName"
  ]
}