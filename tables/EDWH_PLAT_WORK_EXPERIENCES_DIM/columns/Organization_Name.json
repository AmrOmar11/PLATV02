    "    'EDWH_PLAT_WORK_EXPERIENCES_DIM'[ORGANIZATION_OTHER],",
    "    'EDWH_PLAT_WORK_EXPERIENCES_DIM'[OTHER_ORGANIZATION_NAME]",
    ")"
  ]
}