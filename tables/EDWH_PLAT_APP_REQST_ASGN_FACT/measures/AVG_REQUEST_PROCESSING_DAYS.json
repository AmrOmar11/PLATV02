{
  "name": "AVG_REQUEST_PROCESSING_DAYS",
  "expression": [
    "",
    "VAR Requests =",
    "    VALUES(",
    "        'EDWH_PLAT_APP_REQST_ASGN_FACT'[APPLICANT_REQ_KEY]",
    "    )",
    "RETURN",
    "    AVERAGEX(",
    "        Requests,",
    "",
    "        VAR FirstCreatedKey =",
    "            CALCULATE(",
    "                MIN(",
    "                    'EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT]",
    "                )",
    "            )",
    "",
    "        VAR LastCompletedKey =",
    "            CALCULATE(",
    "                MAX(",
    "                    'EDWH_PLAT_APP_REQST_ASGN_FACT'[COMPLETED_AT]",
    "                ),",
    "                'EDWH_PLAT_APP_REQST_ASGN_FACT'[COMPLETED_AT] <> -1,",
    "                NOT ISBLANK(",
    "                    'EDWH_PLAT_APP_REQST_ASGN_FACT'[COMPLETED_AT]",
    "                )",
    "            )",
    "",
    "        VAR FirstCreatedDate =",
    "            CALCULATE(",
    "                MIN(",
    "                    'REQST_ASGN_COMPLETED_AT_DATE'[DATE]",
    "                ),",
    "                'REQST_ASGN_COMPLETED_AT_DATE'[COMMON_DATE_DIM_KEY]",
    "                    = FirstCreatedKey",
    "            )",
    "",
    "        VAR LastCompletedDate =",
    "            CALCULATE(",
    "                MIN(",
    "                    'COMMON_DATE_DIM'[DATE]",
    "                ),",
    "                'COMMON_DATE_DIM'[COMMON_DATE_DIM_KEY]",
    "                    = LastCompletedKey",
    "            )",
    "",
    "        RETURN",
    "            IF(",
    "                NOT ISBLANK(FirstCreatedDate)",
    "                    && NOT ISBLANK(LastCompletedDate),",
    "                DATEDIFF(",
    "                    FirstCreatedDate,",
    "                    LastCompletedDate,",
    "                    DAY",
    "                )",
    "            )",
    "    )"
  ]
}