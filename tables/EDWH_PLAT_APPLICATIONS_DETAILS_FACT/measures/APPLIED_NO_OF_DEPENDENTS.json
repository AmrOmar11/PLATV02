{
  "name": "APPLIED_NO_OF_DEPENDENTS",
  "expression": [
    "",
    "SUMX(",
    "    VALUES(",
    "        'EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICANT_KEY]",
    "    ),",
    "    CALCULATE(",
    "        MAX(",
    "            'EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[NO_OF_DEPENDENTS]",
    "        ),",
    "       not 'EDWH_PLAT_APPLICATIONS_DETAILS_FACT'[APPLICATION_STATUS_KEY]",
    "            IN { 25, 26, 28 }",
    "    )",
    ")"
  ]
}