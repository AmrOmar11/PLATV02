          {
            "type": "calculated",
            "name": "_MAIN_STATUS",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR StatusID = VALUE('EDWH_PLAT_APPLICATION_STATUS_DIM'[APP_STATUS_ID])",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ISBLANK(StatusID), BLANK(),",
              "    StatusID IN {100, 110}, \"Registered\",",
              "    StatusID IN {170, 140, 160, 165, 180}, \"تحت المعالجة\",",
              "    StatusID = 120, \"تم التقديم\",",
              "    StatusID IN {190, 200, 400}, \"مصدر\",",
              "    BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "_OVERALL_STATUS",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR StatusID = VALUE('EDWH_PLAT_APPLICATION_STATUS_DIM'[APP_STATUS_ID])",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ISBLANK(StatusID) || StatusID = -1, BLANK(),",
              "",
              "    StatusID IN {200, 190, 400}, \"حاصل\",",
              "",
              "    StatusID IN {130, 300}, \"مستبعد\",",
              "",
              "    \"مقدم\"",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "_MAIN_STATUS COPY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "EDWH_PLAT_APPLICATION_STATUS_DIM[_MAIN_STATUS]"
          }
