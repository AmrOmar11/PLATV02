{
  "type": "calculated",
  "name": "IS_REQUEST_DATE",
  "dataType": "int64",
  "isDataTypeInferred": true,
  "expression": [
    "",
    "VAR CurrentDate =",
    "    COMMON_DATE_DIM[DATE]",
    "",
    "VAR MinDateKey =",
    "    CALCULATE(",
    "        MIN('EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT]),",
    "        ALL('EDWH_PLAT_APP_REQST_ASGN_FACT')",
    "    )",
    "",
    "VAR MaxDateKey =",
    "    CALCULATE(",
    "        MAX('EDWH_PLAT_APP_REQST_ASGN_FACT'[CREATED_AT]),",
    "        ALL('EDWH_PLAT_APP_REQST_ASGN_FACT')",
    "    )",
    "",
    "VAR MinDate =",
    "    CALCULATE(",
    "        MIN('COMMON_DATE_DIM'[DATE]),",
    "        FILTER(",
    "            ALL('COMMON_DATE_DIM'),",
    "            'COMMON_DATE_DIM'[COMMON_DATE_DIM_KEY] = MinDateKey",
    "        )",
    "    )",
    "",
    "VAR MaxDate =",
    "    CALCULATE(",
    "        MAX('COMMON_DATE_DIM'[DATE]),",
    "        FILTER(",
    "            ALL('COMMON_DATE_DIM'),",
    "            'COMMON_DATE_DIM'[COMMON_DATE_DIM_KEY] = MaxDateKey",
    "        )",
    "    )",
    "",
    "RETURN",
    "    IF(",
    "        CurrentDate >= MinDate",
    "            && CurrentDate <= MIN(MaxDate, TODAY()),",
    "        1,",
    "        0",
    "    )"
  ]
}