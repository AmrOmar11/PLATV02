          },
          {
            "type": "calculated",
            "name": "AGE",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR TodayDateKey =",
              "    LOOKUPVALUE(",
              "        'COMMON_DATE_DIM'[COMMON_DATE_DIM_KEY],",
              "        'COMMON_DATE_DIM'[DATE],",
              "        TODAY()",
              "    )",
              "",
              "VAR DaysOld = IF(EDWH_PLAT_APPLICANT_FACT[BIRTH_DATE_KEY] = -1,BLANK(),",
              "    TodayDateKey -",
              "    'EDWH_PLAT_APPLICANT_FACT'[BIRTH_DATE_KEY])",
              "",
              "RETURN",
              "    INT(DaysOld / 365.2425)"
            ]
          },
          {
            "type": "calculated",
            "name": "AGE_GROUP",
            "dataType": "string",
            "expression": "SWITCH( TRUE(), ISBLANK('EDWH_PLAT_APPLICANT_FACT'[AGE]), \"Other\", 'EDWH_PLAT_APPLICANT_FACT'[AGE] < 20, \"Other\", 'EDWH_PLAT_APPLICANT_FACT'[AGE] <= 29, \"20 - 29\", 'EDWH_PLAT_APPLICANT_FACT'[AGE] <= 39, \"30 - 39\", 'EDWH_PLAT_APPLICANT_FACT'[AGE] <= 49, \"40 - 49\", 'EDWH_PLAT_APPLICANT_FACT'[AGE] <= 59, \"50 - 59\", 'EDWH_PLAT_APPLICANT_FACT'[AGE] <= 65, \"60 - 65\", \"More than 65\" )"
          },
          {
            "type": "calculated",
            "name": "AGE_GROUP_SORT",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "SWITCH( [AGE_GROUP], \"Other\", 1, \"20 - 29\", 2, \"30 - 39\", 3, \"40 - 49\", 4, \"50 - 59\", 5, \"60 - 65\", 6, \"More than 65\", 7 )"
          }
        ],
        "partitions": [
          {
            "name": "EDWH_PLAT_APPLICANT_FACT",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [EDWH].[EDWH_PLAT_APPLICANT_FACT].*   FROM [EDWH].[EDWH_PLAT_APPLICANT_FACT] ",
              "dataSource": "SqlServer DESKTOP-61EFDIR EDWH"
            }
          }
        ],
        "measures": [
          {
            "name": "AVERAGE_AGE",
            "expression": [
              "",
              "AVERAGEX(",
              "    VALUES('EDWH_PLAT_APPLICANT_FACT'[APPLICANT_KEY]),",
              "    CALCULATE(",
              "        MAX('EDWH_PLAT_APPLICANT_FACT'[AGE])",
              "    )",
              ")"
            ]
          },
          {
            "name": "APPLICANT_COUNT",
            "expression": "DISTINCTCOUNT(EDWH_PLAT_APPLICANT_FACT[APPLICANT_KEY])"
          },
          {
            "name": "ACTIVE_APPLICANTS",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT(EDWH_PLAT_APPLICANT_FACT[APPLICANT_KEY]),",
              "    EDWH_PLAT_NIC_IQAMA_STATUS_DIM[IQAMA_STATUS_ID] = 1",
              ")"
            ]
          },
          {
            "name": "COUNT",
            "expression": "DISTINCTCOUNT(EDWH_PLAT_APPLICANT_FACT[APPLICANT_KEY])"
          },
          {
            "name": "NO_OF_NATIONALITIES",
            "expression": [
              "DISTINCTCOUNT(",
              "    'EDWH_PLAT_APPLICANT_FACT'[NATIONALITY_KEY]",
              ")"
            ]
          },
          {
            "name": "TOTAL_HOLDERS",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT(EDWH_PLAT_APPLICATIONS_DETAILS_FACT[APPLICANT_KEY]),",
              "    EDWH_PLAT_ISSUING_STATUS_DIM[ISSUING_STATUS_ID] = 120",
              ")"
            ]
          }
        ],
